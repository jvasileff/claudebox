; npm 11.16 does not run a dependency's install scripts unless the package
; is listed here, and warns about every unlisted one on each install. The
; three below are transitive dependencies of the @earendil-works/pi-*
; packages; nothing Codex or Claude Code installs has an install script.
; Listing them keeps the warning meaningful: a package that newly starts
; running install scripts is then the only thing reported.
;
; Maintain these by hand. `npm approve-scripts`, which the warning tells
; you to run, exits with EGLOBAL against a global install, and npm 11.16.0
; matched only on the bare package name, ignoring entries qualified with
; an exact version such as protobufjs@7.6.5.
allow-scripts[]=protobufjs
allow-scripts[]=@google/genai
allow-scripts[]=esbuild

; Silence the "N packages are looking for funding" line that npm prints
; after every install or update, including the one codexbox runs at start.
fund=false

; Silence the "New major version of npm available" notice. Node LTS
; bundles its own npm and that is the one we keep, so the notice is noise.
update-notifier=false
